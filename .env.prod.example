# Production namunasi — /home/qazolar/.env qilib nusxalab, quyidagilarni
# haqiqiy qiymatlarga almashtiring:
#   - DJANGO_SECRET_KEY: `python -c "import secrets; print(secrets.token_urlsafe(50))"`
#   - POSTGRES_PASSWORD: kuchli, tasodifiy parol

# Django
DJANGO_SECRET_KEY=change-me-to-a-real-random-value
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=qazolar.uz,www.qazolar.uz

# Postgres
POSTGRES_DB=qazolar
POSTGRES_USER=qazolar
POSTGRES_PASSWORD=change-me-to-a-strong-password
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Redis / Celery
REDIS_URL=redis://redis:6379/0

# Email (OTP delivery — parolni tiklash shu orqali yuboriladi).
# Hozircha console backend: parolni-tiklash kodi haqiqatan emailga
# yuborilmaydi, faqat backend konteyner logiga chiqadi (`docker compose logs
# backend`). Haqiqiy SMTP (Gmail/Mailgun/boshqa) qo'shilganda shu qatorlarni
# almashtiring:
#   EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
#   EMAIL_HOST=smtp.example.com
#   EMAIL_PORT=587
#   EMAIL_USE_TLS=True
#   EMAIL_HOST_USER=...
#   EMAIL_HOST_PASSWORD=...
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=noreply@qazolar.uz

# Frontend
NEXT_PUBLIC_API_BASE=/api
